<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2: el modo actual en un círculo. Tocar alterna ANC → Transparencia → Normal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/s_header"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/s_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/s_battery"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:tint="@color/fg" />

        <TextView
            android:id="@+id/s_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/fg_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/circle_sel" />

            <ImageView
                android:id="@+id/s_ic_anc"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_anc"
                android:tint="@color/on_sel"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/s_ic_tr"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_transparency"
                android:tint="@color/on_sel"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/s_ic_off"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_off"
                android:tint="@color/on_sel"
                android:visibility="gone" />

        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/s_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/fg"
        android:textSize="12sp" />
</LinearLayout>
