<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2: ícono de matriz de puntos del modo actual. Tocar alterna
     ANC → Transparencia → Normal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp">

            <ImageView
                android:id="@+id/s_status_on"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/dot_red" />

            <ImageView
                android:id="@+id/s_status_off"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/dot_grey"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/s_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/s_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/fg_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/s_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxHeight="56dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:tint="@color/fg" />
    </FrameLayout>

    <ImageView
        android:id="@+id/s_headline"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="center_horizontal"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:tint="@color/fg" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

    <FrameLayout
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/s_ind_anc_on"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ind_on"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/s_ind_anc_off"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ind_off" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/s_ind_tr_on"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ind_on"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/s_ind_tr_off"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ind_off" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="6dp"
        android:layout_height="6dp">

        <ImageView
            android:id="@+id/s_ind_off_on"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ind_on"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/s_ind_off_off"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ind_off" />
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
