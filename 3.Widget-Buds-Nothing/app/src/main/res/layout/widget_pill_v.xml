<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1x2 (vertical): cápsula de 72 dp de grosor (como los íconos de apps) con los tres modos.
     El modo activo va en un círculo invertido. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/capsule_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/pv_btn_anc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pv_sel_anc"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/circle_sel"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pv_ic_anc_idle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_anc"
                android:tint="@color/fg" />

            <ImageView
                android:id="@+id/pv_ic_anc_sel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_anc"
                android:tint="@color/on_sel"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/pv_btn_tr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pv_sel_tr"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/circle_sel"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pv_ic_tr_idle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_transparency"
                android:tint="@color/fg" />

            <ImageView
                android:id="@+id/pv_ic_tr_sel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_transparency"
                android:tint="@color/on_sel"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/pv_btn_off"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/pv_sel_off"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/circle_sel"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pv_ic_off_idle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_off"
                android:tint="@color/fg" />

            <ImageView
                android:id="@+id/pv_ic_off_sel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mode_off"
                android:tint="@color/on_sel"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
