<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:colorAccent">@color/nt_red</item>
        <item name="android:textColorPrimary">@color/fg</item>
    </style>

    <style name="Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/fg_secondary</item>
    </style>

    <style name="Label">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/fg_secondary</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Row">
        <item name="android:background">@drawable/row_card</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Pill">
        <item name="android:background">@drawable/pill_idle</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Pill.Primary">
        <item name="android:background">@drawable/pill_sel</item>
        <item name="android:textColor">@color/on_sel</item>
    </style>
</resources>
